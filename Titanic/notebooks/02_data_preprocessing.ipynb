    "# Ticket 패턴 추출 및 분석\n",
    "print(\"🎫 Ticket 패턴 분석\")\n",
    "\n",
    "# 티켓에서 접두사 추출 함수\n",
    "def extract_ticket_prefix(ticket):\n",
    "    if pd.isna(ticket):\n",
    "        return 'NO_TICKET'\n",
    "    \n",
    "    # 공백과 점(.) 제거\n",
    "    ticket_clean = str(ticket).replace(' ', '').replace('.', '').upper()\n",
    "    \n",
    "    # 숫자만 있는 경우\n",
    "    if ticket_clean.isdigit():\n",
    "        return 'NUMERIC_ONLY'\n",
    "    \n",
    "    # 알파벳 부분 추출 (숫자 전까지)\n",
    "    prefix = ''\n",
    "    for char in ticket_clean:\n",
    "        if char.isalpha() or char == '/':\n",
    "            prefix += char\n",
    "        else:\n",
    "            break\n",
    "    \n",
    "    return prefix if prefix else 'NUMERIC_ONLY'\n",
    "\n",
    "# 티켓 접두사 추출\n",
    "all_data['Ticket_Prefix'] = all_data['Ticket'].apply(extract_ticket_prefix)\n",
    "\n",
    "# 티켓 접두사 분포 확인\n",
    "print(\"\\n📊 Ticket 접두사 분포 (상위 15개):\")\n",
    "ticket_counts = all_data['Ticket_Prefix'].value_counts().head(15)\n",
    "for prefix, count in ticket_counts.items():\n",
    "    print(f\"  {prefix}: {count}개\")\n",
    "\n",
    "print(f\"\\n총 {all_data['Ticket_Prefix'].nunique()}개의 서로 다른 티켓 패턴\")\n",
    "\n",
    "# Embarked와의 연관성\n",
    "print(\"\\n🔗 Ticket Prefix와 Embarked 연관성 (상위 10개 prefix):\")\n",
    "top_prefixes = all_data['Ticket_Prefix'].value_counts().head(10).index\n",
    "for prefix in top_prefixes:\n",
    "    embarked_dist = all_data[all_data['Ticket_Prefix'] == prefix]['Embarked'].value_counts()\n",
    "    print(f\"\\n{prefix}:\")\n",
    "    for port, count in embarked_dist.items():\n",
    "        pct = (count / embarked_dist.sum()) * 100\n",
    "        print(f\"  {port}: {count}개 ({pct:.1f}%)\")\n",
    "\n",
    "# Pclass와의 연관성\n",
    "print(\"\\n🔗 Ticket Prefix와 Pclass 연관성 (상위 10개 prefix):\")\n",
    "for prefix in top_prefixes:\n",
    "    pclass_dist = all_data[all_data['Ticket_Prefix'] == prefix]['Pclass'].value_counts().sort_index()\n",
    "    print(f\"\\n{prefix}:\")\n",
    "    for pclass, count in pclass_dist.items():\n",
    "        pct = (count / pclass_dist.sum()) * 100\n",
    "        print(f\"  {pclass}등실: {count}개 ({pct:.1f}%)\")\n",
    "\n",
    "# Has_Cabin과의 연관성\n",
    "print(\"\\n🔗 Ticket Prefix와 Cabin 유무 연관성 (상위 10개 prefix):\")\n",
    "for prefix in top_prefixes:\n",
    "    cabin_dist = all_data[all_data['Ticket_Prefix'] == prefix]['Has_Cabin'].value_counts()\n",
    "    print(f\"\\n{prefix}:\")\n",
    "    for has_cabin, count in cabin_dist.items():\n",
    "        pct = (count / cabin_dist.sum()) * 100\n",
    "        cabin_label = \"Cabin 있음\" if has_cabin == 1 else \"Cabin 없음\"\n",
    "        print(f\"  {cabin_label}: {count}개 ({pct:.1f}%)\")\n",
    "\n",
    "print(\"\\n✅ Ticket 패턴 분석 완료!\")"
   ]
