    "print(\"⚡ 고급 상호작용 특성 생성\")\n",
    "\n",
    "# 5-1. Pclass와 Sex 조합 (1등실 여성 vs 3등실 남성의 생존율 차이 극대화)\n",
    "all_data['Pclass_Sex'] = all_data['Pclass'].astype(str) + '_' + all_data['Sex']\n",
    "print(f\"- Pclass_Sex 조합: {all_data['Pclass_Sex'].nunique()}개 그룹\")\n",
    "\n",
    "# 5-2. 어린이 여부와 성별 조합 (어린 남자아이 생존율 높음)\n",
    "def age_sex_category(row):\n",
    "    if row['Age'] < 16:\n",
    "        return 'Child'\n",
    "    else:\n",
    "        return row['Sex']\n",
    "\n",
    "all_data['Age_Sex_Group'] = all_data.apply(age_sex_category, axis=1)\n",
    "print(f\"- Age_Sex_Group: {all_data['Age_Sex_Group'].unique()}\")\n",
    "\n",
    "# 5-3. 1인당 요금 (가족 규모를 고려한 실질 요금)\n",
    "all_data['Fare_Per_Person'] = all_data['Fare'] / all_data['Family_Size']\n",
    "print(f\"- Fare_Per_Person: 평균 {all_data['Fare_Per_Person'].mean():.2f}\")\n",
    "\n",
    "# 5-4. 이름 길이 (귀족은 이름이 긴 경향)\n",
    "all_data['Name_Length'] = all_data['Name'].str.len()\n",
    "print(f\"- Name_Length: 평균 {all_data['Name_Length'].mean():.1f}자\")\n",
    "\n",
    "# 5-5. 괄호 포함 여부 (maiden name 등 추가 정보)\n",
    "all_data['Has_Parentheses'] = all_data['Name'].str.contains('\\(').astype(int)\n",
    "parentheses_count = all_data['Has_Parentheses'].sum()\n",
    "print(f\"- Has_Parentheses: {parentheses_count}명이 괄호 포함\")\n",
    "\n",
    "print(f\"\\n✅ 고급 상호작용 특성 5개 추가 완료!\")\n",
    "print(\"💡 이 특성들은 XGBoost 같은 고급 모델에서 큰 성능 향상을 가져올 수 있습니다.\")"
   ]
