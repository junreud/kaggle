   "source": [
    "# Ticket 패턴 기반 특성 생성\n",
    "print(\"🎯 Ticket 패턴을 활용한 특성 생성\")\n",
    "\n",
    "# 1. 주요 티켓 패턴 그룹화 (빈도와 생존율 기반)\n",
    "# 분석 결과를 바탕으로 의미있는 그룹으로 묶기\n",
    "def categorize_ticket_prefix(prefix):\n",
    "    # 1등급 관련 (보통 높은 생존율)\n",
    "    if prefix in ['PC', 'C']:\n",
    "        return 'Premium'\n",
    "    \n",
    "    # 특정 항구/지역 관련\n",
    "    elif prefix in ['CA', 'SOTON', 'STON']:\n",
    "        return 'Regional'\n",
    "    \n",
    "    # A 시리즈 (A/4, A/5 등)\n",
    "    elif prefix.startswith('A/'):\n",
    "        return 'A_Series'\n",
    "    \n",
    "    # W, SC, PP 등\n",
    "    elif prefix in ['W/C', 'SC', 'PP', 'WE/P', 'SOC', 'SOP']:\n",
    "        return 'Special'\n",
    "    \n",
    "    # 숫자만 있는 경우 (가장 흔함)\n",
    "    elif prefix == 'NUMERIC_ONLY':\n",
    "        return 'Standard'\n",
    "    \n",
    "    # 나머지\n",
    "    else:\n",
    "        return 'Other'\n",
    "\n",
    "all_data['Ticket_Group'] = all_data['Ticket_Prefix'].apply(categorize_ticket_prefix)\n",
    "\n",
    "# 2. 티켓 그룹별 생존율 확인 (훈련 데이터만)\n",
    "print(\"\\n📊 Ticket Group별 생존율:\")\n",
    "train_temp = all_data[all_data['is_train'] == 1].copy()\n",
    "ticket_survival = train_temp.groupby('Ticket_Group')['Survived'].agg(['count', 'mean']).round(3)\n",
    "ticket_survival.columns = ['승객 수', '생존율']\n",
    "ticket_survival = ticket_survival.sort_values('생존율', ascending=False)\n",
    "print(ticket_survival)\n",
    "\n",
    "# 3. 티켓 번호의 숫자 부분 길이 (복잡도 지표)\n",
    "def get_ticket_number_length(ticket):\n",
    "    if pd.isna(ticket):\n",
    "        return 0\n",
    "    # 숫자만 추출\n",
    "    numbers = ''.join(filter(str.isdigit, str(ticket)))\n",
    "    return len(numbers)\n",
    "\n",
    "all_data['Ticket_Number_Length'] = all_data['Ticket'].apply(get_ticket_number_length)\n",
